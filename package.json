{
  "name": "clicker-simulator",
  "version": "1.2.0",
  "description": "Clicker Simulator",
  "main": "main.js",
  "author": "BielzinYT",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.0",
    "electron-log": "^5.1.0"
  },
  "build": {
    "appId": "com.bielzinyt.clickersimulator",
    "productName": "Clicker Simulator",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "supabase.js",
      "musica.mp3",
      "som_clique.mp3",
      "som_ovo.mp3"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icon.ico",
      "artifactName": "Clicker-Simulator-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clicker Simulator"
    },
    "publish": [
      { "provider": "github", "owner": "BielzinYT", "repo": "clicker-simulator" }
    ]
  }
}